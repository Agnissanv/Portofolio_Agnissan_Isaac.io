{
  "functions": {
    "api/notify.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/notify",
      "schedule": "0 8 * * *"
    }
  ],
  "headers": [
    {
      "source": "/images/(projets|blog|clients|membre|partners)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/images/:file",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/(css|js)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=600, stale-while-revalidate=3600"
        }
      ]
    }
  ]
}
